PLATFORM_NAME=Sonic Calling
BUSINESS_NAME=Sonic Calling Labs
DISCLOSURE_LINE=Hi, this is the Sonic Calling AI assistant from Sonic Calling Labs on a recorded call.
PUBLIC_BASE_URL=http://127.0.0.1:8000
PUBLIC_WEBSOCKET_BASE=ws://127.0.0.1:8000

OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_WS_BASE=wss://api.openai.com/v1/realtime
OPENAI_REALTIME_REST_BASE=https://api.openai.com/v1/realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_INPUT_AUDIO_FORMAT=g711_ulaw
OPENAI_OUTPUT_AUDIO_FORMAT=g711_ulaw
OPENAI_INPUT_SAMPLE_RATE=8000
OPENAI_OUTPUT_SPEED=1.0
OPENAI_MAX_OUTPUT_TOKENS=700
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIPTION_LANGUAGE=en
OPENAI_INPUT_NOISE_REDUCTION=near_field
OPENAI_TURN_DETECTION_MODE=server_vad
OPENAI_TURN_CREATE_RESPONSE=true
OPENAI_TURN_INTERRUPT_RESPONSE=true
OPENAI_IDLE_TIMEOUT_MS=8000
OPENAI_VAD_PREFIX_PADDING_MS=300
OPENAI_VAD_SILENCE_DURATION_MS=500
OPENAI_VAD_THRESHOLD=0.5
OPENAI_SEMANTIC_EAGERNESS=medium
OPENAI_TRACING_MODE=auto

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_SAY_VOICE=Polly.Joanna

QUIET_HOURS_START=9
QUIET_HOURS_END=20
